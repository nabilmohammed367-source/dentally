    {
      "parameters": {
        "jsCode": "const practiceId = $('Scenario Input').first().json.practice_id;\nconst agents = $('Get Agents (Practice)').all().map(function(i){ return i.json; }).filter(function(r){ return r.agent_id; });\nconst appts = $('Get Appointments (Briefing)').all().map(function(i){ return i.json; }).filter(function(r){ return r.appointment_id; });\nconst convos = $('Get Conversations (Briefing)').all().map(function(i){ return i.json; }).filter(function(r){ return r.conversation_id; });\nconst approvals = $('Get Approvals (Briefing)').all().map(function(i){ return i.json; }).filter(function(r){ return r.approval_id; });\nconst events = $('Get Activity Events (Briefing)').all().map(function(i){ return i.json; }).filter(function(r){ return r.event_id; });\n\nconst statusCounts = { Confirmed: 0, Arrived: 0, Completed: 0, Cancelled: 0 };\nappts.forEach(function(a){ if (statusCounts.hasOwnProperty(a.status)) statusCounts[a.status]++; });\n\nconst bookingsCreated = events.filter(function(e){ return e.type === 'appointment.created'; }).length;\nconst cancellations = events.filter(function(e){ return e.type === 'appointment.cancelled'; }).length;\nconst slotsFilled = events.filter(function(e){ return e.type === 'waitlist.filled'; }).length;\nconst waitlistDeclined = events.filter(function(e){ return e.type === 'waitlist.declined'; }).length;\nconst remindersFollowups = events.filter(function(e){ return e.type === 'reminder_prepared' || e.type === 'followup_sent'; }).length;\nconst clinicalEscalations = events.filter(function(e){ return e.type === 'clinical_escalation'; }).length;\nconst humanRequests = events.filter(function(e){ return e.type === 'human_request'; }).length;\n\nconst conversationsNeedingAttention = convos.filter(function(c){ return c.status === 'Needs attention'; }).length;\nconst pendingApprovals = approvals.filter(function(a){ return a.status === 'Pending'; }).length;\n\nconst enabledAgents = agents.filter(function(a){ return a.enabled; }).map(function(a){ return a.agent_name; });\nconst pausedAgents = agents.filter(function(a){ return !a.enabled; }).map(function(a){ return a.agent_name; });\n\nconst actionItems = [];\nif (conversationsNeedingAttention > 0) actionItems.push(conversationsNeedingAttention + ' conversation(s) need staff attention.');\nif (pendingApprovals > 0) actionItems.push(pendingApprovals + ' approval(s) are pending review.');\nif (clinicalEscalations > 0) actionItems.push(clinicalEscalations + ' clinical concern(s) flagged - urgent.');\nif (pausedAgents.length > 0) actionItems.push('Paused agents: ' + pausedAgents.join(', ') + '.');\nif (actionItems.length === 0) actionItems.push('No outstanding action items.');\n\nconst summary = 'Your practice has ' + statusCounts.Confirmed + ' confirmed appointment(s), ' + conversationsNeedingAttention + ' conversation(s) requiring staff attention, and ' + pendingApprovals + ' approval(s) waiting. Finn filled ' + slotsFilled + ' cancelled slot(s) from the waitlist this session.';\n\nreturn [{ json: {\n  practice_id: practiceId,\n  generated_at: new Date().toISOString(),\n  summary: summary,\n  metrics: {\n    appointments_by_status: statusCounts,\n    bookings_created: bookingsCreated,\n    cancellations: cancellations,\n    slots_filled_by_finn: slotsFilled,\n    waitlist_declined: waitlistDeclined,\n    conversations_needing_attention: conversationsNeedingAttention,\n    pending_approvals: pendingApprovals,\n    reminders_and_followups_sent: remindersFollowups,\n    clinical_escalations: clinicalEscalations,\n    human_requests: humanRequests,\n    enabled_agents: enabledAgents,\n    paused_agents: pausedAgents\n  },\n  action_items: actionItems\n} }];"
      },
