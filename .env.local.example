# Copy this file to .env.local and fill in your key. Never commit .env.local.
NEXT_PUBLIC_DENTALOS_LIVE=true
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
DENTALOS_WEBHOOK_BASE_URL=http://localhost:5678/webhook/dentalos-demo
DENTALOS_WEBHOOK_SECRET=PASTE_YOUR_KEY_HERE
# Explicit server-side allowlist. Add a real practice ID only after it is provisioned and isolated in n8n.
DENTALOS_ALLOWED_PRACTICES=prac_oakwood,prac_riverside,prac_harbor
