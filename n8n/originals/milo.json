      "id": "8871439b-de78-4f60-a70a-ce8bb78ad673",
      "name": "Get Appointments (Milo Booking)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1648,
        0
      ],
      "alwaysOutputData": true
