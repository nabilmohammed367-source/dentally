      "id": "35b93d20-09e4-4004-94c8-f4805d702d20",
      "name": "Get Appointments (Booking Check)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1392,
        -400
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const scenario = $('Scenario Input').first().json;\nconst existing = $input.all().map(function(i) { return i.json; }).filter(function(r) { return r.appointment_id && r.status !== 'Cancelled'; });\nconst startIso = scenario.preferred_date + 'T' + scenario.preferred_time + ':00.000Z';\nconst start = new Date(startIso);\nconst end = new Date(start.getTime() + 30 * 60000);\nconst providers = ['Dr. Adeyemi', 'Dr. Novak'];\nlet chosenProvider = null;\nlet chosenChair = null;\nconst chairs = ['Chair 1', 'Chair 2'];\nfor (let p = 0; p < providers.length; p++) {\n  for (let c = 0; c < chairs.length; c++) {\n    const conflict = existing.some(function(r) {\n      const rStart = new Date(r.start_time);\n      const rEnd = new Date(r.end_time);\n      const overlaps = start < rEnd && end > rStart;\n      return overlaps && (r.provider === providers[p] || r.chair === chairs[c]);\n    });\n    if (!conflict) { chosenProvider = providers[p]; chosenChair = chairs[c]; break; }\n  }\n  if (chosenProvider) break;\n}\nconst available = !!chosenProvider;\nreturn [{ json: { available: available, provider: chosenProvider, chair: chosenChair, start_time: start.toISOString(), end_time: end.toISOString() } }];"
      },
