        1632,
        -608
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const approval = $('Get Approval').first().json;\nconst agents = $('Get Agents (Recheck)').all().map(function(i){ return i.json; }).filter(function(r){ return r.agent_id; });\nconst nameToAgentId = { Ava: 'reception', Milo: 'support', Luna: 'reminders', Finn: 'waitlist', Iris: 'followup', Leo: 'operations' };\nconst agentId = nameToAgentId[approval.requested_by];\nconst agent = agents.find(function(a){ return a.agent_id === agentId; });\nconst agentEnabled = agent ? !!agent.enabled : false;\nconst patient = $('Get Patient (Recheck)').first().json;\nconst consentField = approval.kind === 'recall' ? 'consent_marketing' : 'consent_appointment';\nconst hasConsent = patient ? !!patient[consentField] : false;\nconst eligible = agentEnabled && hasConsent;\nconst reasons = [];\nif (!agentEnabled) reasons.push(approval.requested_by + ' is now paused.');\nif (!hasConsent) reasons.push('Patient no longer has the required consent.');\nreturn [{ json: { eligible: eligible, reasons: reasons.join(' ') } }];"
      },
