    {
      "parameters": {
        "jsCode": "const scenario = $('Scenario Input').first().json;\nconst original = $('Get Appointment To Reschedule').first().json;\nconst existing = $input.all().map(function(i) { return i.json; }).filter(function(r) { return r.appointment_id && r.appointment_id !== original.appointment_id && r.status !== 'Cancelled'; });\nconst startIso = scenario.preferred_date + 'T' + scenario.preferred_time + ':00.000Z';\nconst start = new Date(startIso);\nconst end = new Date(start.getTime() + 30 * 60000);\nconst conflict = existing.some(function(r) {\n  const rStart = new Date(r.start_time);\n  const rEnd = new Date(r.end_time);\n  const overlaps = start < rEnd && end > rStart;\n  return overlaps && (r.provider === original.provider || r.chair === original.chair);\n});\nreturn [{ json: { available: !conflict, new_start: start.toISOString(), new_end: end.toISOString() } }];"
