    {
      "parameters": {
        "jsCode": "const scenario = $('Scenario Input').first().json;\nconst existing = $input.all().map(function(i) { return i.json; }).filter(function(r) { return r.appointment_id && r.status !== 'Cancelled'; });\nconst start = new Date(scenario.preferred_date + 'T' + scenario.preferred_time + ':00.000Z');\nconst end = new Date(start.getTime() + 30 * 60000);\nconst providers = ['Dr. Adeyemi', 'Dr. Novak'];\nconst chairs = ['Chair 1', 'Chair 2'];\nlet chosenProvider = null, chosenChair = null;\nfor (let p = 0; p < providers.length; p++) { for (let c = 0; c < chairs.length; c++) { const conflict = existing.some(function(r) { const rs = new Date(r.start_time); const re = new Date(r.end_time); const overlap = start < re && end > rs; return overlap && (r.provider === providers[p] || r.chair === chairs[c]); }); if (!conflict) { chosenProvider = providers[p]; chosenChair = chairs[c]; break; } } if (chosenProvider) break; }\nreturn [{ json: { available: !!chosenProvider, provider: chosenProvider, chair: chosenChair, start_time: start.toISOString(), end_time: end.toISOString() } }];"
      },
