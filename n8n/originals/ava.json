      "id": "3a7b45cd-2865-47ab-b211-76dce7ec9e64",
      "name": "Get Appointments (Availability)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1392,
        -800
      ],
      "alwaysOutputData": true
