    {
      "parameters": {
        "jsCode": "const scenario = $('Scenario Input').first().json;\nconst existing = $input.all().map(function(i) { return i.json; }).filter(function(r) { return r.appointment_id && r.status !== 'Cancelled'; });\nconst dateStr = scenario.preferred_date;\nconst busyTimes = {};\nexisting.forEach(function(r) {\n  const d = new Date(r.start_time);\n  const key = d.toISOString().slice(0, 10);\n  if (key === dateStr) {\n    const hhmm = ('0' + d.getUTCHours()).slice(-2) + ':' + ('0' + d.getUTCMinutes()).slice(-2);\n    busyTimes[hhmm] = true;\n  }\n});\nconst candidateTimes = ['09:00','09:30','10:00','10:30','11:00','13:00','13:30','14:00','14:30','15:00','15:30','16:00'];\nconst free = candidateTimes.filter(function(t) { return !busyTimes[t]; }).slice(0, 3);\nreturn [{ json: { practice_id: scenario.practice_id, preferred_date: dateStr, available_slots: free, response: free.length ? ('I can offer ' + free.join(' or ') + ' on ' + dateStr + '. Which works better?') : ('No slots available on ' + dateStr + ' - would you like to try another day?') } }];"
      },
      "id": "dec110e9-b1b8-49ae-8d3e-818e6fba6b3c",
      "name": "Compute Availability",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        -800
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "2bAmrhgGbNIsh23J"
        },
        "filters": {
