      "id": "933c0563-568e-4f08-a22c-a288445274b9",
      "name": "Get Patients (Finn)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2112,
        -608
      ],
      "executeOnce": true,
      "alwaysOutputData": true
