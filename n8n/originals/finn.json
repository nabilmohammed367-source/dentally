    {
      "parameters": {
        "jsCode": "const appt = $('Get Released Appointment').first().json;\nconst waitlist = $('Get Waitlist Entries').all().map(function(i){ return i.json; }).filter(function(r){ return r.waitlist_id && r.status === 'Waiting' && r.treatment === appt.treatment; });\nconst patients = $('Get Patients (Finn)').all().map(function(i){ return i.json; }).filter(function(r){ return r.patient_id; });\nwaitlist.sort(function(a, b){ return new Date(a.joined_at) - new Date(b.joined_at); });\nconst best = waitlist[0];\nif (!best) { return [{ json: { found: false, response: 'No matching waitlist patients for ' + appt.treatment + ' at this practice.' } }]; }\nconst patient = patients.find(function(p){ return p.patient_id === best.patient_id; });\nconst patientName = patient ? patient.name : best.patient_id;\nconst message = 'Hi ' + patientName + ', a ' + appt.treatment + ' slot just opened up on ' + appt.start_time + '. Would you like to take it?';\nreturn [{ json: { found: true, waitlist_id: best.waitlist_id, patient_id: best.patient_id, patient_name: patientName, treatment: appt.treatment, message: message, response: 'Best match: ' + patientName + ' (waitlist_id ' + best.waitlist_id + ', joined ' + best.joined_at + '). Invitation queued for approval.' } }];"
      },
